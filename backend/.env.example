DATABASE_URL=sqlite:///./commatour.db

KORSERVICE_API_KEY=your_decoded_service_key

KAKAO_REST_API_KEY=your_kakao_rest_api_key

# 프론트엔드(.env.local)의 NEXT_PUBLIC_KAKAO_MAP_KEY와 동일한 "JavaScript 키"를 사용할 것 (REST API 키 아님).
# PDF 지도 이미지를 헤드리스 브라우저로 렌더링할 때 카카오맵 JS SDK를 로드하기 위해 필요.
KAKAO_JS_API_KEY=your_kakao_javascript_key

FRONTEND_BASE_URL=http://localhost:3000