# 한국관광공사 OpenAPI 서비스 키 (KorService2, TatsCnctrRateService, TarRlteTarService1 공용)
KORSERVICE_API_KEY=

# [6순위] 카카오모빌리티 자동차 길찾기 API REST 키 (백엔드 .env의 KAKAO_REST_API_KEY와 동일한 키 사용)
KAKAO_REST_API_KEY=

# 로컬 임베딩 모델 이름 (sentence-transformers 계열, 한국어 지원)
# 후보 예시: jhgan/ko-sroberta-multitask, intfloat/multilingual-e5-base
EMBEDDING_MODEL_NAME=jhgan/ko-sroberta-multitask

# 목데이터 사용 여부 (API 키 승인 전 true로 두고 파이프라인 골격 먼저 검증)
USE_MOCK_DATA=true
