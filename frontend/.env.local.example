# 백엔드 API 베이스 URL (로컬 개발 시 기본값 http://127.0.0.1:8000 사용, 배포 시 Railway/Render 도메인으로 교체)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 카카오맵 JavaScript 키 (KakaoCourseMap.tsx가 지도 표시에 사용)
# [주의] 백엔드 .env의 KAKAO_REST_API_KEY와는 다른 키다.
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > "JavaScript 키"를 사용할 것 (REST API 키 아님).
# 또한 콘솔의 "플랫폼 > Web" 설정에 실제 배포 도메인(Vercel URL 등)을 등록해야 지도가 뜬다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
